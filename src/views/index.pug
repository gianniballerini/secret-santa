main#app
  //- Organizer ------------------------------------------------------------
  section#organizer.screen(hidden aria-labelledby="organizer-title")
    header
      h1#organizer-title.title Amigo invisible
      p.lead Agregá a todos, sorteá una sola vez y mandale a cada persona su enlace privado. No abras los enlaces vos, ¡o arruinás la sorpresa!

    .card
      span.card__art.card__art--gifts(aria-hidden="true")
      h2#add-title.card__title ¿Quién participa?
      form#add-form.add(novalidate)
        .field
          label.field__label(for="name-input") Nombre
          input#name-input.input(type="text" autocomplete="off" maxlength="40" placeholder="p. ej. María")
        p#form-error.field__error(role="alert" hidden)
        button.btn.btn--primary.btn--block(type="submit") Agregá

      ul#participant-list.list(aria-label="Participantes")
      p#empty-state.muted Todavía no hay nadie. Agregá al menos 3 personas para sortear.

      .actions
        button#draw-btn.btn.btn--gold.btn--block(type="button" disabled) Sorteá
        p#draw-hint.muted Agregá al menos 3 personas para sortear.

    section#results.card(hidden aria-labelledby="results-title")
      h2#results-title.card__title Enlaces privados
      p.muted Copiá cada enlace y mandáselo a la persona correcta. Si volvés a sortear, tenés que mandar los enlaces nuevos, porque los anteriores ya no coinciden.
      ul#results-list.list(aria-label="Enlaces privados")
      .actions
        button#download-btn.btn.btn--primary.btn--block(type="button") Descargá los enlaces
        button#redraw-btn.btn.btn--secondary.btn--block(type="button") Sorteá de nuevo

  //- Reveal ---------------------------------------------------------------
  //- The intro greets the giver on the jar's back label (3D). This slip carries the same copy for screen readers and the no-WebGL fallback. The recipient is never in the DOM before the reveal.
  section#reveal.reveal(hidden)
    p#reveal-live.sr-only(aria-live="polite")
    #stage.stage(role="button" tabindex="0" aria-label="Frasco con papelitos. Tocá para sacar el tuyo." aria-busy="true")
      #stage-canvas.stage__canvas
      .stage__loading(aria-hidden="true")
        span Cargando
      .stage__ring(aria-hidden="true")
      p.stage__hint(aria-hidden="true") Sacar papelito
      .paper(hidden aria-hidden="true")
        span.paper__lead Tu amigo invisible es:
        span#paper-name.paper__name
    //- Sound control while the camera is on the radio: the pill is its keyboard and touch twin. Outside #stage, which is inert during the intro.
    .sound-dock
      button#sound-pill.sound-pill(type="button")
        span#sound-pill-lead.sound-pill__lead
        span#sound-pill-track.sound-pill__track
      //- Lucide volume-2 / volume-x (ISC).
      button#sound-mute.icon-btn.icon-btn--mute(type="button" data-sound-control aria-pressed="false")
        svg.icon-btn__on(xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false")
          path(d="M11 4.702a.705.705 0 0 0-1.203-.498L6.413 7.587A1.4 1.4 0 0 1 5.416 8H3a1 1 0 0 0-1 1v6a1 1 0 0 0 1 1h2.416a1.4 1.4 0 0 1 .997.413l3.383 3.384A.705.705 0 0 0 11 19.298z")
          path(d="M16 9a5 5 0 0 1 0 6")
          path(d="M19.364 18.364a9 9 0 0 0 0-12.728")
        svg.icon-btn__off(xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false")
          path(d="M11 4.702a.7.7 0 0 0-1.203-.498L6.413 7.587A1.4 1.4 0 0 1 5.416 8H3a1 1 0 0 0-1 1v6a1 1 0 0 0 1 1h2.416a1.4 1.4 0 0 1 .997.413l3.383 3.384A.7.7 0 0 0 11 19.298z")
          path(d="m16.5 14.5 5-5")
          path(d="m16.5 9.5 5 5")
    //- Credits while the paper is up in 3D: canvas text can't hold links, so they live here.
    #credits-caption.credits-caption(hidden role="group" aria-label="Créditos")
      ul#credits-caption-links.credits-links
      button#credits-caption-close.credits-close(type="button")
    aside#sheet.sheet(hidden tabindex="-1" aria-labelledby="sheet-title")
      span.sheet__handle(aria-hidden="true")
      h2#sheet-title.sheet__title
      ul#sheet-list.sheet__list
    #intro.intro
      .intro__loading(aria-hidden="true")
        span Cargando
      .intro__body
        h1#intro-greeting.intro__greeting
        p#intro-warning.intro__paper.intro__warning
      button#intro-btn.btn.btn--gold.btn--block.intro__btn(type="button")

  //- Error ----------------------------------------------------------------
  section#error.screen(hidden)
    .card
      span.card__art.card__art--error(aria-hidden="true")
      h1.card__title ¡Uy!
      p Este enlace no parece correcto. Pedile al organizador que te lo mande de nuevo.
      a.btn.btn--secondary.btn--block(href="#" id="home-link") Volver al inicio

//- Top-right controls, above every view and the intro. Lucide icons (ISC), see docs/CREDITS.md.
.toolbar
  button#credits.icon-btn(type="button" aria-haspopup="dialog" aria-expanded="false")
    svg(xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false")
      circle(cx="12" cy="12" r="10")
      path(d="M12 16v-4")
      path(d="M12 8h.01")
  button#sound.icon-btn(type="button" data-sound-control aria-pressed="false")
    svg.icon-btn__music(xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false")
      path(d="M21 16V3a1 1 0 0 0-1.28-.96l-10 2.917a1 1 0 0 0-.72.96V19")
      path(d="M21 6 9 9.5")
      circle(cx="18" cy="16" r="3")
      circle(cx="6" cy="19" r="3")
    svg.icon-btn__back(xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false")
      path(d="m12 19-7-7 7-7")
      path(d="M19 12H5")

//- Credits as a paper when the 3D one is not available (organizer, error, intro, loading, no WebGL).
dialog#credits-dialog.credits-dialog(aria-labelledby="credits-dialog-title")
  .credits-dialog__paper
    h2#credits-dialog-title.credits-dialog__title
    ul#credits-dialog-items.credits-dialog__items
    ul#credits-dialog-links.credits-links
    button#credits-dialog-close.credits-close(type="button")
